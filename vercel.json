{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "opauto-clicker.com"}],
      "destination": "https://www.opauto-clicker.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload"}
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|ico|svg|woff2)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/landing.css",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=300, must-revalidate, stale-while-revalidate=86400"}
      ]
    }
  ]
}
